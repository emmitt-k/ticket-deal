# ─── .env.docker.example ──────────────────────────────────────────────────
#
# Template for the Docker-mode environment.
#
# ONE-TIME SETUP — pick one:
#
#   (a) Manual:
#         cp .env.docker.example .env.docker
#         $EDITOR .env.docker         # fill in JWT_SECRET (see below)
#
#   (b) Auto (recommended — reuses JWT_SECRET from your host .env if
#       present, otherwise generates a random one):
#         scripts/setup-docker-env.sh
#
# Then:
#         docker compose --env-file .env.docker up -d
#
# Once .env.docker exists, this file is the source of truth — feel free to
# edit it for local overrides. .env (host mode) and .env.docker are kept
# independent on purpose so each runtime has its own config.
#
# After `make` or `scripts/setup-docker-env.sh` runs, .env.docker is
# gitignored — secrets must never be committed.

# ─── API ─────────────────────────────────────────────────────────────────
API_PORT=8080

# ─── JWT secret ──────────────────────────────────────────────────────────
# REQUIRED. Must be ≥ 32 bytes. Generate with:  openssl rand -hex 32
# If you have a host-side .env with a JWT_SECRET, reuse the same value so
# tokens minted by `make mintjwt` (host) verify against the dockerised API.
JWT_SECRET=replace_me_with_a_32_byte_random_hex_value
# (scripts/setup-docker-env.sh does the copy/generate for you automatically.)

# ─── Redis ───────────────────────────────────────────────────────────────
# Service name `redis` resolves via Docker's user-defined network.
REDIS_ADDR=redis:6379
REDIS_PASSWORD=

# ─── Postgres ────────────────────────────────────────────────────────────
POSTGRES_USER=tickets
POSTGRES_PASSWORD=tickets
POSTGRES_DB=tickets
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgres://tickets:tickets@postgres:5432/tickets?sslmode=disable

# ─── Queue (ElasticMQ locally, AWS SQS in prod) ──────────────────────────
SQS_ENDPOINT_URL=http://elasticmq:9324
SQS_QUEUE_NAME=reservations
SQS_QUEUE_URL=http://elasticmq:9324/000000000000/reservations

# The Stripe webhook events queue — a SEPARATE queue from the
# reservations one, because the two carry unrelated message types.
STRIPE_EVENTS_QUEUE_URL=http://elasticmq:9324/000000000000/stripe-events

# ─── Stripe (Layer 2, item 7 — OPTIONAL) ───────────────────────────────
#
# Leave BOTH secret values empty and the payment feature is OFF: the
# /pay and /webhooks/stripe routes answer 503, and the rest of the
# system works exactly as before.
#
# Set exactly ONE of them and the API refuses to start — a
# half-configured Stripe (can create PaymentIntents but cannot verify
# webhooks) is a bug, not a choice.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Safe to expose to a browser — the client needs it to confirm a
# payment with Stripe Elements.
STRIPE_PUBLISHABLE_KEY=

# ─── Worker / Watcher tuning ──────────────────────────────────────────────
WORKER_LONG_POLL_SECONDS=20
SWEEP_INTERVAL_SECONDS=60

# ─── OpenTelemetry ───────────────────────────────────────────────────────
# `jaeger` is the service name in docker-compose.yml. The all-in-one image
# receives OTLP/gRPC on 4317.
OTEL_EXPORTER_OTLP_ENDPOINT=http://jaeger:4317

# ─── Logging ─────────────────────────────────────────────────────────────
# `text` for `docker logs` readability; switch to `json` for any pipeline
# that wants to parse it.
LOG_LEVEL=info
LOG_FORMAT=text
SERVICE_VERSION=dev

# ─── Dashboard server ────────────────────────────────────────────────────
# k6's REST API runs on the HOST (start with K6_WEB_DASHBOARD=true k6 run ...).
# host.docker.internal is the standard Docker escape to the host on macOS/
# Windows; on Linux Docker, set this up via `extra_hosts:` in compose.
K6_REST_URL=http://host.docker.internal:6565
DASHBOARD_ADDR=:8082
DASHBOARD_HTML=/app/loadtest/dashboard.html
