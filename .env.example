# ─── API ──────────────────────────────────────────────────────
API_PORT=8080

# Generate with:  openssl rand -hex 32
# REQUIRED: must be ≥ 32 bytes, otherwise the API will panic at startup.
JWT_SECRET=

# ─── Redis ────────────────────────────────────────────────────
REDIS_ADDR=localhost:6379
REDIS_DB=0

# ─── IP Rate Limit (Phase 4 — per-IP token bucket) ─────────────
# Max tokens per IP before hard rejection (429).
IP_LIMIT_CAPACITY=10
# Tokens refilled per second per IP.
IP_LIMIT_REFILL_RATE=2

# ─── Event Waiting Room (Phase 4 — per-event token bucket) ─────
# Max users admitted "instantly" (burst size).
WAIT_ROOM_CAPACITY=100
# Steady-state users admitted per second per event.
WAIT_ROOM_REFILL_RATE=10
# Seconds before a queued user's entry is auto-removed (stale session cleanup).
WAIT_ROOM_QUEUE_TTL=300

# ─── Postgres ─────────────────────────────────────────────────
POSTGRES_USER=tickets
POSTGRES_PASSWORD=tickets
POSTGRES_DB=tickets
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgres://tickets:tickets@localhost:5432/tickets?sslmode=disable

# ─── Queue (ElasticMQ locally, AWS SQS in prod) ───────────────
SQS_ENDPOINT_URL=http://localhost:9324
SQS_QUEUE_NAME=reservations
SQS_QUEUE_URL=http://localhost:9324/000000000000/reservations

# ─── Worker ───────────────────────────────────────────────────
WORKER_LONG_POLL_SECONDS=20
SWEEP_INTERVAL_SECONDS=60

# ─── AWS SDK ──────────────────────────────────────────────────
# Required for aws-sdk-go-v2 even when pointing at local ElasticMQ.
# Any non-empty values work locally; use real IAM creds in prod.
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=localdev
AWS_SECRET_ACCESS_KEY=localdev
